<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:section title="AI PR Review">
    <f:entry title="Default AI tool" field="tool">
      <f:textbox default="claude" placeholder="claude | codex | copilot"/>
    </f:entry>
    <f:entry title="Default endpoint" field="endpoint">
      <f:textbox default="direct" placeholder="direct | bedrock | vertex | custom"/>
    </f:entry>
    <f:entry title="Default model" field="model"><f:textbox/></f:entry>
    <f:entry title="Default gate" field="gate">
      <f:textbox default="none" placeholder="none | unstable | failure"/>
    </f:entry>
    <f:entry title="AWS region" field="awsRegion"><f:textbox/></f:entry>
    <f:entry title="Vertex project id" field="vertexProjectId"><f:textbox/></f:entry>
    <f:entry title="Vertex region" field="vertexRegion"><f:textbox/></f:entry>
    <f:entry title="Anthropic base URL" field="anthropicBaseUrl"><f:textbox/></f:entry>
    <f:entry title="OpenAI base URL" field="openaiBaseUrl"><f:textbox/></f:entry>
    <f:entry title="GitHub server URL (GHE)" field="githubServerUrl"><f:textbox/></f:entry>
    <f:entry title="Anthropic API key credential id" field="anthropicApiKeyCredentialsId"><f:textbox/></f:entry>
    <f:entry title="OpenAI API key credential id" field="openaiApiKeyCredentialsId"><f:textbox/></f:entry>
    <f:entry title="GitHub token credential id" field="githubTokenCredentialsId"><f:textbox/></f:entry>
    <f:entry title="Adjudication" field="adjudication">
      <f:textbox default="self" placeholder="self | independent | off"/>
    </f:entry>
    <f:entry title="Adjudication model" field="adjudicationModel"><f:textbox/></f:entry>
  </f:section>
</j:jelly>
