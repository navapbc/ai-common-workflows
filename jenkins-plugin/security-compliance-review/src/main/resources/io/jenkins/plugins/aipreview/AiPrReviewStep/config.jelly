<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="AI tool" field="tool">
    <f:textbox default="" placeholder="claude | codex | copilot (default: global config)"/>
  </f:entry>
  <f:entry title="Endpoint" field="endpoint">
    <f:textbox default="" placeholder="direct | bedrock | vertex | azure | custom"/>
  </f:entry>
  <f:entry title="Model" field="model">
    <f:textbox placeholder="model id / Bedrock model id / Azure deployment (optional)"/>
  </f:entry>
  <f:entry title="Compliance profile" field="profile">
    <f:textbox placeholder="baseline (default) | cms-ars | profile name or path"/>
  </f:entry>
  <f:entry title="Gate" field="gate">
    <f:textbox default="none" placeholder="none | unstable | failure"/>
  </f:entry>
  <f:entry title="Post comments" field="postComments">
    <f:checkbox default="true"/>
  </f:entry>
  <f:entry title="Dry run" field="dryRun">
    <f:checkbox default="false"/>
  </f:entry>
  <f:entry title="Fetch base ref" field="fetchBase">
    <f:checkbox default="true"/>
  </f:entry>
  <f:entry title="PR number" field="pr">
    <f:textbox placeholder="defaults to CHANGE_ID"/>
  </f:entry>
  <f:entry title="Base ref (--against)" field="against">
    <f:textbox placeholder="defaults to origin/CHANGE_TARGET"/>
  </f:entry>

  <f:section title="Credentials">
    <f:entry title="Anthropic API key credential" field="anthropicApiKeyCredentialsId">
      <f:textbox placeholder="Secret text credential id"/>
    </f:entry>
    <f:entry title="OpenAI API key credential" field="openaiApiKeyCredentialsId">
      <f:textbox placeholder="Secret text credential id"/>
    </f:entry>
    <f:entry title="GitHub token credential" field="githubTokenCredentialsId">
      <f:textbox placeholder="Secret text credential id"/>
    </f:entry>
  </f:section>

  <f:advanced>
    <f:entry title="AWS region" field="awsRegion"><f:textbox/></f:entry>
    <f:entry title="Vertex project id" field="vertexProjectId"><f:textbox/></f:entry>
    <f:entry title="Vertex region" field="vertexRegion"><f:textbox/></f:entry>
    <f:entry title="Anthropic base URL" field="anthropicBaseUrl"><f:textbox/></f:entry>
    <f:entry title="OpenAI base URL" field="openaiBaseUrl">
      <f:textbox placeholder="gateway URL; for endpoint=azure, the full Azure deployment URL incl. api-version"/>
    </f:entry>
    <f:entry title="Copilot BYOK base URL" field="copilotProviderBaseUrl">
      <f:textbox placeholder="tool=copilot: your model endpoint (COPILOT_PROVIDER_BASE_URL)"/>
    </f:entry>
    <f:entry title="Copilot BYOK provider type" field="copilotProviderType">
      <f:textbox placeholder="openai | azure | anthropic"/>
    </f:entry>
    <f:entry title="Copilot BYOK API key credential" field="copilotProviderApiKeyCredentialsId">
      <f:textbox placeholder="Secret text credential id"/>
    </f:entry>
    <f:entry title="Copilot BYOK model" field="copilotModel">
      <f:textbox placeholder="model id (COPILOT_MODEL); else use Model above"/>
    </f:entry>
    <f:entry title="GitHub server URL (GHE)" field="githubServerUrl"><f:textbox/></f:entry>
    <f:entry title="Adjudication" field="adjudication">
      <f:textbox placeholder="self | independent | off"/>
    </f:entry>
    <f:entry title="Adjudication model" field="adjudicationModel"><f:textbox/></f:entry>
    <f:entry title="Jobs" field="jobs"><f:number/></f:entry>
    <f:entry title="Batch by" field="batchBy"><f:textbox placeholder="dir | file"/></f:entry>
    <f:entry title="Batch min files" field="batchMinFiles"><f:number/></f:entry>
    <f:entry title="Context budget" field="contextBudget"><f:number/></f:entry>
    <f:entry title="Engine override path (dev)" field="engineOverridePath"><f:textbox/></f:entry>
  </f:advanced>
</j:jelly>
