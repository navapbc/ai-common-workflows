#!/usr/bin/env bash
# engines/security-compliance-review/harness/ai-pr-review
#
# AI-assisted PR review: composes security + compliance perspectives into a
# single review of a pull-request diff and (optionally) posts the result as
# inline review comments on the PR. A thin entrypoint over the shared runtime
# in engines/_common (see engines/_common/CONTRACT.md).
#
# Usage:
#   ai-pr-review --against origin/main                # review; print only
#   ai-pr-review --pr 1234 --post-comments            # review + post inline comments
#   ai-pr-review --against origin/main --gate         # exit 1 on non-APPROVE
#   ai-pr-review --against origin/main --json-out f   # also write findings JSON
#   ai-pr-review --post-only --pr 1234 --json-in f    # post previously produced JSON
#   ai-pr-review --dry-run --against origin/main      # show plan, no AI call
#
# The engine is relocatable: this script resolves everything it needs from
# its own location (ENGINE_HOME), never from the repository being reviewed.
# Run it with the reviewed repository as the working directory.
#
# The --json-out / --post-only pair is the seam the sandboxed flow uses to
# split the run into two processes: an AI phase with no SCM access or token
# (writes --json-out), and a trusted post phase with no AI (reads --json-in).
#
# Exit codes:
#   0  APPROVE, or findings in advisory mode (or --dry-run / --no-block)
#   1  --gate with non-APPROVE result, or unrecoverable runtime error
#   2  configuration error (AI_REVIEW_TOOL unset/invalid; bad flags)

set -euo pipefail

# ── Engine self-location ────────────────────────────────────────────────────
# Resolved purely from this script's own path. The working directory is the
# reviewed repository; `git rev-parse` here would find the wrong root.
# ENGINE_HOME is this workflow's engine (engines/security-compliance-review);
# the shared runtime lives in the sibling engines/_common.
ENGINE_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
AI_COMMON_HOME="$(cd "${ENGINE_HOME}/../_common" && pwd)"

SKILL_NAME="pr-review"
SKILL_HUMAN_NAME="AI-Assisted PR Review (security + compliance)"
# Defaults in _common already match this workflow; set explicitly for clarity.
AI_REVIEW_MARKER_VOCAB="APPROVE|COMMENT|REQUEST_CHANGES"
AI_REVIEW_JSON_MARKER="AI_REVIEW_JSON"

# shellcheck source=../../_common/harness/core.sh
source "${AI_COMMON_HOME}/harness/core.sh"
# shellcheck source=../../_common/endpoints.sh
source "${AI_COMMON_HOME}/endpoints.sh"

AI_REVIEW_SCM="${AI_REVIEW_SCM:-github}"
if [[ ! -f "${AI_COMMON_HOME}/scm/${AI_REVIEW_SCM}.sh" ]]; then
  ai_review::err "AI_REVIEW_SCM='${AI_REVIEW_SCM}' has no backend at _common/scm/${AI_REVIEW_SCM}.sh"
  ai_review::log "  Available backends: $(find "${AI_COMMON_HOME}/scm" -name '*.sh' -exec basename {} .sh \; | tr '\n' ' ')"
  exit 2
fi
# shellcheck source=../../_common/scm/github.sh
source "${AI_COMMON_HOME}/scm/${AI_REVIEW_SCM}.sh"

# ── Compliance profile resolution ───────────────────────────────────────────
# A profile supplies additions to the compliance rubric (and may override any
# base skill outright). AI_REVIEW_PROFILE is a bundled name under profiles/
# (baseline is the default — the framework-neutral CIS/NIST-CSF/OWASP floor),
# or a path to a custom profile directory (bring-your-own). For pr-review.md
# and code-security.md, the active profile's copy replaces the shared base
# entirely if present. For iac-compliance.md specifically, the shared base is
# ALWAYS applied and the profile's copy (if any) is layered on top as an
# addition, not a replacement — see build_prompt() and docs/profiles.md.
AI_REVIEW_PROFILE="${AI_REVIEW_PROFILE:-baseline}"
if [[ -d "${AI_REVIEW_PROFILE}" ]]; then
  PROFILE_DIR="$(cd "${AI_REVIEW_PROFILE}" && pwd)"
elif [[ -d "${ENGINE_HOME}/skills/profiles/${AI_REVIEW_PROFILE}" ]]; then
  PROFILE_DIR="${ENGINE_HOME}/skills/profiles/${AI_REVIEW_PROFILE}"
else
  ai_review::err "AI_REVIEW_PROFILE='${AI_REVIEW_PROFILE}' is not a known profile or an existing directory."
  ai_review::log "  Bundled profiles: $(find "${ENGINE_HOME}/skills/profiles" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort | tr '\n' ' ')"
  ai_review::log "  Or pass a path to a custom profile directory."
  exit 2
fi

# pr_review::rubric <file> — echo the path to a rubric file, preferring the
# active profile's override, else the shared base in skills/base/. Used for
# pr-review.md and code-security.md (whole-file override semantics). NOT used
# for iac-compliance.md — see pr_review::build_prompt's compliance_block.
pr_review::rubric() {
  if [[ -f "${PROFILE_DIR}/$1" ]]; then
    printf '%s' "${PROFILE_DIR}/$1"
  else
    printf '%s' "${ENGINE_HOME}/skills/base/$1"
  fi
}

