  --no-adjudicate           Force adjudication off. It is already off by
                            default; use this to override AI_ADJUDICATION.

Environment:
  AI_REVIEW_TOOL            claude | codex | copilot   (required)
  AI_REVIEW_PROFILE         same as --profile
  AI_REVIEW_MODEL           model override
  AI_ADJUDICATION           off (default) | self | independent
  AI_REVIEW_CLI_NATIVE_AUTH set to 1 when the CLI is already logged in and no
                            API key is in the environment (PUBLIC endpoint)
  plus the provider variables documented in docs/private-endpoints.md

This entrypoint never posts, never gates, and needs no SCM token.
EOF
}

audit::parse_flags() {
  while (($#)); do
    case "$1" in
      --__audit-one)
        WORKER_MODE=1
        shift
        break
        ;;
      --profile)
        # `$# -ge 2` alone would accept a following FLAG as the value.
        if [[ $# -lt 2 || "$2" == -* ]]; then
          ai_review::err "--profile requires a value (e.g. base,cms-ars-5.1)."
          exit 2
        fi
        AI_REVIEW_PROFILE="$2"
        shift 2
        ;;
      --include)
        # `$# -ge 2` alone would accept a following FLAG as the value.
        if [[ $# -lt 2 || "$2" == -* ]]; then
          ai_review::err "--include requires a glob."
          exit 2
        fi
        INCLUDE_GLOBS+=("$2")
        shift 2
        ;;
      --exclude)
        # `$# -ge 2` alone would accept a following FLAG as the value.
        if [[ $# -lt 2 || "$2" == -* ]]; then
          ai_review::err "--exclude requires a glob."
          exit 2
        fi
        EXCLUDE_GLOBS+=("$2")
        shift 2
        ;;
      --max-file-bytes)
        [[ $# -ge 2 ]] || {
          ai_review::err "--max-file-bytes requires a value."
          exit 2
        }
        [[ "$2" =~ ^[0-9]+$ ]] || {
          ai_review::err "--max-file-bytes must be a number."
          exit 2
        }
        MAX_FILE_BYTES="$2"
        shift 2
        ;;
      --output-parent-dir)
        if [[ $# -lt 2 || "$2" == -* ]]; then
          ai_review::err "--output-parent-dir requires an existing directory."
          exit 2
        fi
        OUTPUT_PARENT="$2"
        shift 2
        ;;
      --json-out)
        # `$# -ge 2` alone would accept a following FLAG as the value.
        if [[ $# -lt 2 || "$2" == -* ]]; then
          ai_review::err "--json-out requires a path."
          exit 2
        fi
        JSON_OUT="$2"
        shift 2
        ;;
      --md-out)
        # `$# -ge 2` alone would accept a following FLAG as the value.
        if [[ $# -lt 2 || "$2" == -* ]]; then
          ai_review::err "--md-out requires a path."
          exit 2
        fi
        MD_OUT="$2"
        shift 2
        ;;
      --json-only)
        JSON_ONLY=1
        shift
        ;;
      --resume)
        RESUME=1
        shift
        ;;
      --doctor)
        DOCTOR=1
        shift
        ;;
      --yes | -y)
        ASSUME_YES=1
        shift
        ;;
      --list-files)
        LIST_FILES=1
        shift
        ;;
      -h | --help)
        ai_review::print_help
        exit 0
        ;;
      # Flags the shared library owns (--jobs, --list-batches, --dry-run,
      # --no-adjudicate, --no-block).
      --jobs | --list-batches | --dry-run | -n | --no-adjudicate | --no-block)
        REMAINING_FOR_LIB+=("$1")
        [[ "$1" == "--jobs" ]] && {
          REMAINING_FOR_LIB+=("${2:-}")
          shift
        }
        shift
        ;;
      # Flags the review has and the audit deliberately does not.
      --gate | --post-comments | --pr | --against | --unpushed | --post-only | --json-in)
        ai_review::err "$1 is not supported by the audit: it is a local, read-only,"
        ai_review::err "  advisory tool — it never posts, never gates, and audits the working tree."
        ai_review::err "  For PR-scoped review with those options, use ai-security-compliance-review."
        exit 2
        ;;
      --)
        shift
        while (($#)); do
          SCOPE_PATHS+=("$1")
          shift
        done
        ;;
      -*)
        ai_review::err "Unknown flag: $1"
        ai_review::log "  Run with --help for usage."
        exit 2
        ;;
      *)
        SCOPE_PATHS+=("$1")
        shift
        ;;
    esac
  done
  WORKER_RECORD="${1:-}"
}

# ── Scope selection ─────────────────────────────────────────────────────────
# git ls-files is the source of truth: tracked files only, so .gitignore is
# honored for free and node_modules/vendor never appear. Working tree contents
# are what get audited (a local tool audits what you have, not what you pushed).
audit::record_skip() {
  local path="$1" reason="$2"
  printf 'SKIP\t%s\t%s\n' "${path}" "${reason}" >&2
  if [[ -n "${AI_AUDIT_SKIP_LOG:-}" ]]; then
    printf '%s\t%s\n' "${path}" "${reason}" >>"${AI_AUDIT_SKIP_LOG}"
  fi
}

audit::scope_files() {
  local -a args=(ls-files -z --cached)
  if ((${#SCOPE_PATHS[@]} > 0)); then
    args+=(--)
    args+=("${SCOPE_PATHS[@]}")
  fi

  local f
  while IFS= read -r -d '' f; do
    [[ -z "${f}" ]] && continue
    # Batch records and worker sentinels reserve tab/newline/pipe delimiters.
    # A path containing one would corrupt scope accounting, so skip it loudly.
    if [[ "${f}" == *$'\n'* ]] || [[ "${f}" == *$'\t'* ]] || [[ "${f}" == *'|'* ]]; then
      audit::record_skip "${f}" "unsupported path characters (newline, tab, or '|')"
      continue
    fi

    # A tracked symlink can target content outside the repository. The audit
    # must only ingest regular in-repo files.
    if [[ -L "${f}" ]]; then
      audit::record_skip "${f}" "symlink (not audited)"
      continue
    fi

    [[ -f "${f}" ]] || continue # staged-deleted or replaced by a directory

    if ((${#INCLUDE_GLOBS[@]} > 0)); then
      local keep=0 g
      for g in "${INCLUDE_GLOBS[@]}"; do
        # shellcheck disable=SC2053  # glob match is intended
        [[ "${f}" == $g ]] && keep=1 && break
      done
      ((keep)) || continue
    fi
    local g
    for g in "${EXCLUDE_GLOBS[@]+"${EXCLUDE_GLOBS[@]}"}"; do
      # shellcheck disable=SC2053
      [[ "${f}" == $g ]] && continue 2
    done

    local size
    size="$(wc -c <"${f}" 2>/dev/null | tr -d ' ')" || continue
    if [[ -n "${size}" ]] && ((size > MAX_FILE_BYTES)); then
      audit::record_skip "${f}" "larger than ${MAX_FILE_BYTES} bytes"
      continue
    fi
    # Binary sniff: a NUL byte in the first 8k. Compares the byte count with
    # and without NULs rather than grepping for one — a NUL cannot be written
    # as a grep pattern portably, and the naive attempt matches every file.
    local head_bytes nul_stripped
    head_bytes="$(LC_ALL=C head -c 8192 "${f}" | wc -c | tr -d ' ')"
    nul_stripped="$(LC_ALL=C head -c 8192 "${f}" | tr -d '\000' | wc -c | tr -d ' ')"
    if [[ "${head_bytes}" != "${nul_stripped}" ]]; then
      audit::record_skip "${f}" "binary"
      continue
    fi
    printf '%s\n' "${f}"
  done < <(git "${args[@]}" 2>/dev/null)
}

audit::scope_description() {
  if ((${#SCOPE_PATHS[@]} > 0)); then
    printf '%s' "$(
      IFS=' '
      echo "${SCOPE_PATHS[*]}"
    )"
  else
    printf 'repository root'
  fi
}

# ── Prompt ──────────────────────────────────────────────────────────────────
audit::build_prompt() {
  local scope_desc
  scope_desc="$(audit::scope_description)"

  local budget_block
  budget_block="$(
    cat <<BUDGET

──────────────────────── CONTEXT BUDGET ────────────────────────
Load at most ${AI_REVIEW_CONTEXT_BUDGET:-15} context file(s) from OUTSIDE the
audit scope below. Files inside the scope are the audit subject and do not
count against this ceiling. If accurate assessment would need more outside
context, stop at the ceiling and note the limitation in the report.
BUDGET
  )"

  # The file manifest IS the scope. A worker gets its batch; a single call gets
  # everything selected.
  local scope_block
  scope_block="$(
    cat <<SCOPE

──────────────────────── AUDIT SCOPE ────────────────────────
Audit exactly these files, in the current working directory. Report findings
ONLY in these files; you may read others for context within the budget above.

${AI_REVIEW_SCOPE_PATHS}
SCOPE
  )"

  # Composed from the listed rubric sources in order (base first when listed).
  local audit_block
  audit_block="$(
    cat <<AUDIT

──────────────────── CODEBASE-AUDIT INSTRUCTIONS ────────────────────
$(ai_review::rubric_block codebase-audit.md "CODEBASE-AUDIT INSTRUCTIONS")
AUDIT
  )"

  # Compliance perspective when the scope contains IaC. Base always applies;
  # each profile's copy is appended as an addition.
  local compliance_block=""
  local iac_rc=0
  ai_review::diff_has_iac || iac_rc=$?
  if ((iac_rc == 0)); then
    compliance_block="$(
      cat <<COMPLIANCE

──────────────────── COMPLIANCE PERSPECTIVE ────────────────────
$(ai_review::rubric_block iac-compliance.md "COMPLIANCE PERSPECTIVE")
COMPLIANCE
    )"
  elif ((iac_rc != 1)); then
    ai_review::err "Could not determine whether the audit scope contains IaC files."
    exit 1
  fi

  local self_adjudication_block=""
  if [[ "${AI_REVIEW_ADJUDICATION_MODE:-off}" == "self" ]]; then
    self_adjudication_block="$(
      cat <<SELFADJ

──────────────────── SELF-ADJUDICATION ────────────────────
$(ai_review::self_adjudication_instructions)
SELFADJ
    )"
  fi

  cat <<PROMPT
You are performing an AI-assisted security and compliance audit of an existing
codebase in the current working directory. Scope: ${scope_desc}. Compliance
profile: ${AI_REVIEW_PROFILE}. This is NOT a review of a change — there is no
diff. Your full instructions follow.
${audit_block}

──────────────────── SECURITY PERSPECTIVE ────────────────────
$(ai_review::rubric_block code-security.md "SECURITY PERSPECTIVE")
${compliance_block}
${budget_block}
${scope_block}
${self_adjudication_block}
PROMPT
}

# audit::require_json <output> <marker> — extract and validate findings JSON.
audit::require_json() {
  local output="$1" marker="$2" json
  if ! json="$(ai_review::extract_review_json "${output}")" || [[ -z "${json}" ]]; then
    return 1
  fi
  ai_review::marker_follows_json "${output}" "${marker}" || return 1
  ai_review::validate_result_contract "audit" "${marker}" "${json}" || return 1
  printf '%s' "${json}"
}

# ── One batch (fan-out worker) ──────────────────────────────────────────────
audit::worker_main() {
  local record="$1"
  ai_review::resolve_tool >/dev/null

  local key="${record%%$'\t'*}"
  local files_pipe="${record#*$'\t'}"
  local files_nl nfiles
  files_nl="$(printf '%s' "${files_pipe}" | tr '|' '\n' | grep -v '^$' || true)"
  nfiles="$(printf '%s\n' "${files_nl}" | grep -cv '^$' || true)"

  export AI_REVIEW_SCOPE_PATHS="${files_nl}"
  export AI_REVIEW_CONTEXT_BUDGET
  AI_REVIEW_CONTEXT_BUDGET="$(ai_review::context_budget "${nfiles}")"
  AI_REVIEW_ADJUDICATION_MODE="$(ai_review::adjudication_mode)"
  export AI_REVIEW_ADJUDICATION_MODE

  ai_review::resolve_profiles
  SKILL_PROMPT="$(audit::build_prompt)"

  local output rc=0 marker="UNPARSEABLE" json_file="-"
  output="$(ai_review::invoke_ai)" || rc=$?
  if ((rc != 0)); then
    ai_review::err "[${key}] AI invocation failed (rc=${rc})." >&2
  else
    marker="$(ai_review::parse_result "${output}")"
    local json_block
    if json_block="$(audit::require_json "${output}" "${marker}")"; then
      # Trailing X's only: BSD/macOS mktemp cannot substitute X's followed by
      # a suffix, and parallel workers would collide on the literal name.
      json_file="$(mktemp "${AI_REVIEW_BATCH_DIR}/batch.XXXXXX")"
      printf '%s\n' "${json_block}" >"${json_file}"
    else
      ai_review::err "[${key}] AI response contained no parseable JSON block." >&2
      marker="UNPARSEABLE"
    fi
  fi

  {
    printf '\n──────── [%s] (%s file(s)) ────────\n' "${key}" "${nfiles}"
    printf '%s\n' "${output}"
  } >&2

  printf 'AI_REVIEW_BATCH_RESULT\t%s\t%s\t%s\n' "${key}" "${marker}" "${json_file}"
}

# ── Report bundle ───────────────────────────────────────────────────────────
# audit::allocate_run_dir — echoes a fresh <parent>/<repo>-<YYYYMMDD>-<NN>.
#
# The parent must ALREADY EXIST and is never created: an audit is pointed at a
# place someone chose to keep reports, and silently creating a deep path is how
# a typo becomes a directory nobody looks in again.
#
# The run number is per-day and allocated by scanning the parent, so a second
# audit of the same repo on the same day never overwrites the first. Reports get
# attached to tickets and compared week to week; an overwritten one is worse
# than a missing one because nobody notices.
# audit::find_resume_dir <parent>
# Echoes the newest existing <parent>/<repo>-* bundle, or nothing.
#
# Deliberately not restricted to today: an audit interrupted last night should
# be resumable this morning, and the directory's date records when the audit
# STARTED, which is the more useful fact about it.
audit::find_resume_dir() {
  local parent="$1" repo newest=""
  repo="$(basename "$(git rev-parse --show-toplevel)")"
  for candidate in "${parent}/${repo}-"*; do
    [[ -d "${candidate}" && -f "${candidate}/_INDEX.md" ]] || continue
    # Lexical order works: the names are <repo>-YYYYMMDD-NN, zero-padded.
    [[ -z "${newest}" || "${candidate}" > "${newest}" ]] && newest="${candidate}"
  done
  printf '%s' "${newest}"
}

audit::allocate_run_dir() {
  local parent="$1"
  if [[ ! -d "${parent}" ]]; then
    ai_review::err "--output-parent-dir '${parent}' does not exist."
    ai_review::err "  It must be an existing directory; the audit will not create it."
    exit 2
  fi
  if [[ ! -r "${parent}" || ! -w "${parent}" || ! -x "${parent}" ]]; then
    ai_review::err "--output-parent-dir '${parent}' must be readable, writable and searchable."
    exit 2
  fi

  local repo date n next
  repo="$(basename "$(git rev-parse --show-toplevel)")"
  date="$(date +%Y%m%d)"
  next=1
  for existing in "${parent}/${repo}-${date}-"*; do
    [[ -e "${existing}" ]] || continue
    n="${existing##*-}"
    [[ "${n}" =~ ^[0-9]+$ ]] || continue
    ((10#${n} >= next)) && next=$((10#${n} + 1))
  done
  printf '%s/%s-%s-%02d' "${parent}" "${repo}" "${date}" "${next}"
}

# audit::filter_resume_scope <files_nl> <coverage_json> <skip_log>
# Prints only files that are new or changed since the previous segment.
audit::filter_resume_scope() {
  local files_nl="$1" coverage_json="$2" skip_log="$3"
  AUDIT_FILES_NL="${files_nl}" python3 - "${coverage_json}" "${skip_log}" <<'PY'
import hashlib, json, os, sys

coverage_path, skip_log = sys.argv[1], sys.argv[2]
previous = {}
if os.path.exists(coverage_path):
    try:
        data = json.load(open(coverage_path, encoding="utf-8"))
    except Exception:
        data = {}
    records = data.get("audited_files", []) if isinstance(data, dict) else []
    if isinstance(records, list):
        for row in records:
            if not isinstance(row, dict):
                continue
            path = row.get("path")
            digest = row.get("sha256")
            if isinstance(path, str) and isinstance(digest, str) and path:
                previous[path] = digest

def sha256(path: str) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()

with open(skip_log, "a", encoding="utf-8") as skips:
    for raw in os.environ.get("AUDIT_FILES_NL", "").split("\n"):
        path = raw.rstrip("\n")
        if not path:
            continue
        try:
            digest = sha256(path)
        except Exception:
            # A file that changed shape between scope planning and hashing must
            # be audited rather than assumed unchanged.
            print(path)
            continue
        if previous.get(path) == digest:
            skips.write(f"{path}\tunchanged since previous segment\n")
            continue
        print(path)
PY
}

# audit::snapshot_file_hashes <audited_files_nl> <out_json>
# Captures file hashes before any model call so resume coverage reflects the
# content that was actually reviewed.
audit::snapshot_file_hashes() {
  local audited_files_nl="$1" out_json="$2"
  AUDIT_FILES_NL="${audited_files_nl}" python3 - "${out_json}" <<'PY'
import hashlib, json, os, sys

out = sys.argv[1]
rows = []
for raw in os.environ.get("AUDIT_FILES_NL", "").splitlines():
    path = raw.rstrip("\n")
    if not path:
        continue
    h = hashlib.sha256()
    try:
        with open(path, "rb") as fh:
            for chunk in iter(lambda: fh.read(65536), b""):
                h.update(chunk)
    except Exception as exc:
        print(f"could not hash {path}: {exc}", file=sys.stderr)
        raise
    rows.append({"path": path, "sha256": h.hexdigest()})

json.dump(rows, open(out, "w", encoding="utf-8"))
PY
}

# audit::write_coverage <existing_coverage_json> <audited_files_nl> <skip_log> <out_json>
# Builds per-file fingerprints and skip reasons for resume/index coverage.
audit::write_coverage() {
  local existing_coverage="$1" audited_files_nl="$2" skip_log="$3" out_coverage="$4" snapshot_json="${5:-}"
  local segment_cov
  segment_cov="$(mktemp)"
  if [[ -n "${snapshot_json}" && -f "${snapshot_json}" ]]; then
    cp "${snapshot_json}" "${segment_cov}"
  else
    AUDIT_FILES_NL="${audited_files_nl}" python3 - "${segment_cov}" <<'PY'
import hashlib, json, sys
import os

out = sys.argv[1]
rows = []
for raw in os.environ.get("AUDIT_FILES_NL", "").split("\n"):
    path = raw.rstrip("\n")
    if not path:
        continue
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(65536), b""):
            h.update(chunk)
    rows.append({"path": path, "sha256": h.hexdigest()})

json.dump(rows, open(out, "w", encoding="utf-8"))
PY
  fi

  python3 - "${existing_coverage}" "${segment_cov}" "${skip_log}" "${out_coverage}" <<'PY'
import json, os, sys

coverage_path, segment_path, skip_log, out_path = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
audited = {}
skipped = []
seen_skips = set()

if os.path.exists(coverage_path):
    try:
        prev = json.load(open(coverage_path, encoding="utf-8"))
    except Exception:
        prev = {}
    for row in (prev.get("audited_files", []) if isinstance(prev, dict) else []):
        if not isinstance(row, dict):
            continue
        path = row.get("path")
        digest = row.get("sha256")
        if isinstance(path, str) and isinstance(digest, str) and path:
            audited[path] = digest
    for row in (prev.get("skipped_files", []) if isinstance(prev, dict) else []):
        if not isinstance(row, dict):
            continue
        path = row.get("path")
        reason = row.get("reason")
        key = (path, reason)
        if isinstance(path, str) and isinstance(reason, str) and key not in seen_skips:
            skipped.append({"path": path, "reason": reason})
            seen_skips.add(key)

try:
    segment = json.load(open(segment_path, encoding="utf-8"))
except Exception:
    segment = []
if isinstance(segment, list):
    for row in segment:
        if not isinstance(row, dict):
            continue
        path = row.get("path")
        digest = row.get("sha256")
        if isinstance(path, str) and isinstance(digest, str) and path:
            audited[path] = digest

# Any file that is now audited should not remain in skipped_files.
if skipped:
    skipped = [row for row in skipped if row.get("path") not in audited]
    seen_skips = {
        (row.get("path"), row.get("reason"))
        for row in skipped
        if isinstance(row.get("path"), str) and isinstance(row.get("reason"), str)
    }

if os.path.exists(skip_log):
    with open(skip_log, encoding="utf-8") as fh:
        for raw in fh:
            raw = raw.rstrip("\n")
            if not raw:
                continue
            path, _, reason = raw.partition("\t")
            if not path or not reason:
                continue
            if path in audited:
                continue
            key = (path, reason)
            if key in seen_skips:
                continue
            skipped.append({"path": path, "reason": reason})
            seen_skips.add(key)

out = {
    "version": 1,
    "audited_files": [{"path": p, "sha256": audited[p]} for p in sorted(audited)],
    "skipped_files": skipped,
}
json.dump(out, open(out_path, "w", encoding="utf-8"))
PY

  rm -f "${segment_cov}"
}

# audit::merge_resume_findings <previous_findings_json> <current_findings_json> <audited_files_nl>
# Merges findings from prior segments into the current findings JSON. The
# current file is updated in place.
audit::merge_resume_findings() {
  local previous_findings="$1" current_findings="$2" audited_files_nl="${3:-}"
  AUDIT_RESUME_FILES_NL="${audited_files_nl}" python3 - "${previous_findings}" "${current_findings}" <<'PY'
import json, os, sys

prev = json.load(open(sys.argv[1], encoding="utf-8")).get("comments") or []
new = json.load(open(sys.argv[2], encoding="utf-8"))
original_comments = [f for f in (new.get("comments") or []) if isinstance(f, dict)]
audited_paths = {
    p.rstrip("\n")
    for p in os.environ.get("AUDIT_RESUME_FILES_NL", "").splitlines()
    if p.rstrip("\n")
}

def key(f):
    return (f.get("path"), f.get("line"), str(f.get("perspective", "")).lower(), f.get("title"))

carried = []
re_audited_previous = []
for f in prev:
    if not isinstance(f, dict):
        continue
    path = str(f.get("path") or "")
    if path and path in audited_paths:
        re_audited_previous.append(f)
        continue
    carried.append(f)

seen = set()
merged = []
for f in original_comments + carried:
    ident = key(f)
    if ident in seen:
        continue
    seen.add(ident)
    merged.append(f)

new["comments"] = merged
new["review_action"] = "COMMENT" if merged else "APPROVE"
merge_changed = merged != original_comments
cleared = sum(1 for f in re_audited_previous if key(f) not in seen)
if merge_changed or cleared:
    paths = sorted({
        str(f.get("path"))
        for f in merged
        if isinstance(f, dict) and f.get("path")
    })
    if merged:
        summary = f"Audited scope summary: {len(merged)} finding(s) across {len(paths)} file(s) with findings."
    else:
        summary = "Audited scope summary: No findings."
    if cleared:
        noun = "finding" if cleared == 1 else "findings"
        summary += f" Cleared {cleared} prior {noun} on re-audited file(s)."
    new["summary"] = summary

json.dump(new, open(sys.argv[2], "w", encoding="utf-8"))
PY
}

# audit::normalize_findings_for_audit <findings_json>
# Rewrites folded review JSON to audit-specific summary wording and markers.
audit::normalize_findings_for_audit() {
  local findings_json="$1"
  AUDIT_FINDINGS_JSON="${findings_json}" python3 - <<'PY'
import json, os

data = json.loads(os.environ.get("AUDIT_FINDINGS_JSON", "{}"))
comments = data.get("comments")
if not isinstance(comments, list):
    comments = []
comments = [c for c in comments if isinstance(c, dict)]
paths = sorted({
    str(c.get("path"))
    for c in comments
    if c.get("path")
})
if comments:
    data["summary"] = f"Audited scope summary: {len(comments)} finding(s) across {len(paths)} file(s) with findings."
else:
    data["summary"] = "Audited scope summary: No findings."

action = str(data.get("review_action", "COMMENT")).upper()
if comments and action == "APPROVE":
    action = "COMMENT"
if not comments:
    action = "APPROVE"
data["review_action"] = action
print(json.dumps(data))
PY
}

# audit::narrative_from_ai_output <model_output>
# Returns only the human-readable narrative outside the JSON block/result
# marker. Heading-only stubs are treated as empty so callers can fall back to a
# synthesized narrative from the parsed JSON.
audit::narrative_from_ai_output() {
  local model_output="$1"
  AI_REVIEW_RAW_OUTPUT="${model_output}" python3 - <<'PY'
import os, re

text = os.environ.get("AI_REVIEW_RAW_OUTPUT", "")
inside_json = False
lines = []

for raw in text.splitlines():
    line = raw.rstrip("\n")
    stripped = line.strip()
    if stripped == "<!-- AI_REVIEW_JSON_BEGIN -->":
        inside_json = True
        continue
    if stripped == "<!-- AI_REVIEW_JSON_END -->":
        inside_json = False
        continue
    if inside_json:
        continue
    if re.fullmatch(r"<<<AI_REVIEW_RESULT:[A-Z_]+>>>", stripped):
        continue
    lines.append(line)

while lines and not lines[0].strip():
    lines.pop(0)
while lines and not lines[-1].strip():
    lines.pop()

# Prefer the final top-level report heading when present. If none are present,
# fall back to adjudication-style headings.
anchor = None
report_anchor = None
for idx, line in enumerate(lines):
    stripped = line.strip()
    heading = re.fullmatch(r"(#{1,6})\s+\S.*", stripped)
    if not heading or len(heading.group(1)) > 2:
        continue
    if re.search(r"\b(audit|report)\b", stripped, flags=re.IGNORECASE):
        report_anchor = idx
        continue
    if re.search(r"\badjudicat\w*\b", stripped, flags=re.IGNORECASE):
        if re.search(r"\b(dismiss(ed|al)?|downgrad(ed|e)?)\b", stripped, flags=re.IGNORECASE):
            continue
        anchor = idx
if report_anchor is not None:
    anchor = report_anchor
elif anchor is None:
    for idx, line in enumerate(lines):
        stripped = line.strip()
        heading = re.fullmatch(r"(#{1,6})\s+\S.*", stripped)
        if heading and len(heading.group(1)) <= 2:
            anchor = idx
            break
if anchor is not None:
    lines = lines[anchor:]

non_heading = [
    ln for ln in lines
    if ln.strip() and not re.fullmatch(r"#{1,6}\s+\S.*", ln.strip())
]
if non_heading:
    print("\n".join(lines))
PY
}

# audit::render_narrative_from_json <findings_json>
# Builds a deterministic human-readable report when no raw model narrative is
# available (for example, fan-out mode where worker narratives stream to stderr).
audit::render_narrative_from_json() {
  local findings_json="$1"
  AUDIT_FINDINGS_JSON="${findings_json}" python3 - <<'PY'
import json, os, re

data = json.loads(os.environ.get("AUDIT_FINDINGS_JSON", "{}"))
summary = str(data.get("summary") or "").strip()
comments = data.get("comments") or []
summary_lc = summary.lower()
pr_summary = (
    ("base ref" in summary_lc)
    or ("inline comments" in summary_lc)
    or bool(re.search(r"\bpr\b", summary_lc))
    or bool(re.search(r"\bdiff(s|ed|ing)?\b", summary_lc))
)
if summary and pr_summary:
    summary = ""
sev_order = ("CRITICAL", "HIGH", "MEDIUM", "LOW")
sev_counts = {k: 0 for k in sev_order}
for c in comments:
    if not isinstance(c, dict):
        continue
    sev = str(c.get("severity", "")).upper()
    if sev in sev_counts:
        sev_counts[sev] += 1
paths = sorted({
    str(c.get("path"))
    for c in comments
    if isinstance(c, dict) and c.get("path")
})

print("## Codebase Audit Report")
print("")
if summary:
    print(summary)
else:
    print(f"Audited scope summary: {len(comments)} finding(s) across {len(paths)} file(s) with findings.")

print("")
if comments:
    print("## Posture")
    print("Findings are present in the audited scope. Review and remediation are required before relying on this result.")
else:
    print("## Posture")
    print("No findings were reported in the audited scope.")

if comments:
    print("")
    print(
        "Severity totals: "
        + ", ".join(f"{k}={sev_counts[k]}" for k in sev_order if sev_counts[k] > 0)
    )

if comments:
    print("")
    print("## Findings")
    for c in comments:
        if not isinstance(c, dict):
            continue
        sev = str(c.get("severity", "LOW")).upper()
        title = str(c.get("title", "Finding"))
        path = str(c.get("path", "(no path)"))
        line = c.get("line")
        loc = f"{path}:{line}" if line is not None else path
        perspective = str(c.get("perspective", "security")).lower()
        print(f"- [{sev}] {loc} ({perspective}) — {title}")
PY
}

# ── Preflight (--doctor) ────────────────────────────────────────────────────
# One answer instead of four separate "it did not work" moments. Deliberately
# non-fatal per check: it reports EVERYTHING wrong in one pass rather than
# stopping at the first, because the common case on a fresh laptop is two or
# three missing at once.
#
# Exits 0 when ready to audit, 1 when something is missing. Warnings (a public
# endpoint, no output directory yet) do not fail it — they are choices, not
# defects.
AUDIT_DOCTOR_FAIL=0

audit::doctor_row() { # <name> <status> <detail>
  printf '  %-26s %-9s %s\n' "$1" "$2" "${3:-}" >&2
}

audit::doctor_missing() {
  AUDIT_DOCTOR_FAIL=1
  audit::doctor_row "$1" "MISSING" "$2"
}

audit::doctor() {
  ai_review::info "Checking what this needs..."

  # ── shell and tools ──
  audit::doctor_row "bash" "ok" "${BASH_VERSION}"
  if command -v git >/dev/null 2>&1; then
    audit::doctor_row "git" "ok" "$(git --version | awk '{print $3}')"
  else
    audit::doctor_missing "git" "xcode-select --install (macOS), or your package manager"
  fi
  # python3 is the one macOS does not really ship: the stub prompts for Xcode.
  if command -v python3 >/dev/null 2>&1; then
    audit::doctor_row "python3" "ok" "$(python3 -c 'import sys; print(".".join(map(str, sys.version_info[:3])))' 2>/dev/null || echo present)"
  else
    audit::doctor_missing "python3" "brew install python, or xcode-select --install"
  fi

  # ── the AI CLI ──
  local tool="${AI_REVIEW_TOOL:-}"
  if [[ -z "${tool}" ]]; then
    audit::doctor_missing "AI_REVIEW_TOOL" "export AI_REVIEW_TOOL=claude   (or codex, or copilot)"
  else
    case "${tool}" in
      claude | codex | copilot)
        if command -v "${tool}" >/dev/null 2>&1; then
          audit::doctor_row "${tool} CLI" "ok" "$(command -v "${tool}")"
        else
          # The hint has to name the tool the operator actually chose. A
          # hardcoded Claude package told a copilot user to install Claude
          # Code, which is the one thing doctor exists to not do.
          local cli_hint
          case "${tool}" in
            claude) cli_hint="npm install -g @anthropic-ai/claude-code" ;;
            codex) cli_hint="npm install -g @openai/codex" ;;
            copilot) cli_hint="npm install -g @github/copilot" ;;
            *) cli_hint="install the CLI for AI_REVIEW_TOOL=${tool}" ;;
          esac
          audit::doctor_missing "${tool} CLI" "${cli_hint}"
        fi
        ;;
      *)
        audit::doctor_missing "AI_REVIEW_TOOL" "'${tool}' is not one of: claude | codex | copilot"
        ;;
    esac
  fi

  # ── endpoint and credentials ──
  # configure_endpoint validates the whole provider/credential matrix and exits
  # on failure, so run it in a subshell and read the verdict rather than
  # duplicating the matrix here — the duplicate would drift.
  local provider="${AI_REVIEW_PROVIDER:-api}" endpoint_out endpoint_rc=0
  if [[ -n "${AI_REVIEW_TOOL:-}" ]]; then
    endpoint_out="$(ai_review::resolve_tool >/dev/null 2>&1 && ai_review::configure_endpoint 2>&1)" || endpoint_rc=$?
    if ((endpoint_rc == 0)); then
      if [[ "${provider}" == "api" ]]; then
        # Name the credential source. "ok" against the public endpoint means
        # something different when the key is in the environment than when it
        # is the operator's own CLI login, and doctor exists to remove exactly
        # that kind of guess.
        if ai_review::cli_native_auth; then
          audit::doctor_row "endpoint" "ok" "api — PUBLIC, via the ${AI_REVIEW_TOOL:-CLI} CLI login (AI_REVIEW_CLI_NATIVE_AUTH=1)"
        else
          audit::doctor_row "endpoint" "ok" "api — PUBLIC; set AI_REVIEW_PROVIDER for in-boundary"
        fi
      else
        audit::doctor_row "endpoint" "ok" "${provider} — in your boundary"
      fi
      # configure_endpoint can succeed and still have something to say — most
      # importantly for copilot, whose model auth is a GitHub token it never
      # hard-fails on ("the copilot CLI must already be authenticated on this
      # host"). Discarding that turned "ok" into a claim doctor could not
      # back: no token at all still printed a clean row. Warnings are echoed
      # under the row that earned them, indented like the FAILED path.
      if [[ -n "${endpoint_out}" ]]; then
        printf '%s\n' "${endpoint_out}" |
          grep -v "^\[.*\] Endpoint: tool=" |
          grep . |
          sed 's/^/      /' >&2 || true
      fi
    else
      AUDIT_DOCTOR_FAIL=1
      audit::doctor_row "endpoint" "FAILED" "provider=${provider}"
      printf '%s\n' "${endpoint_out}" | sed 's/^/      /' >&2
    fi
  else
    audit::doctor_row "endpoint" "-" "set AI_REVIEW_TOOL first"
  fi

  # ── rubric ──
  local profile_out profile_rc=0
  profile_out="$(ai_review::resolve_profiles 2>&1)" || profile_rc=$?
  if ((profile_rc == 0)); then
    audit::doctor_row "profile" "ok" "${AI_REVIEW_PROFILE}"
  else
    AUDIT_DOCTOR_FAIL=1
    audit::doctor_row "profile" "FAILED" "${AI_REVIEW_PROFILE}"
    printf '%s\n' "${profile_out}" | sed 's/^/      /' >&2
  fi

  # ── where it would run, and where the report would go ──
  if git rev-parse --show-toplevel >/dev/null 2>&1; then
    audit::doctor_row "repo" "ok" "$(git rev-parse --show-toplevel)"
  else
    # Not a defect: you can check your setup before cd-ing into a repo.
    audit::doctor_row "repo" "-" "not inside a git repository (cd into one to audit)"
  fi
  if [[ -z "${OUTPUT_PARENT}" ]]; then
    audit::doctor_row "output dir" "-" "--output-parent-dir is required for a real run"
  elif [[ ! -d "${OUTPUT_PARENT}" ]]; then
    audit::doctor_missing "output dir" "'${OUTPUT_PARENT}' does not exist; mkdir -p it"
  elif [[ ! -r "${OUTPUT_PARENT}" || ! -w "${OUTPUT_PARENT}" || ! -x "${OUTPUT_PARENT}" ]]; then
    audit::doctor_missing "output dir" "'${OUTPUT_PARENT}' must be readable, writable and searchable"
  else
    audit::doctor_row "output dir" "ok" "${OUTPUT_PARENT}"
  fi

  ai_review::log ""
  if ((AUDIT_DOCTOR_FAIL == 1)); then
    ai_review::err "Not ready — fix the MISSING/FAILED rows above."
    exit 1
  fi
  ai_review::ok "Ready to audit."
  ai_review::log "  Next:  --dry-run to see scope and cost, then drop it to run."
  exit 0
}

# ── Main ────────────────────────────────────────────────────────────────────
audit::run() {
  ai_review::resolve_profiles
  # codebase-audit.md carries the result marker and findings-JSON contract.
  ai_review::require_rubric codebase-audit.md

  if [[ -n "${CI:-}" ]]; then
    ai_review::warn "CI is set. This is an ad-hoc local tool: a full-repo audit costs"
    ai_review::warn "  roughly (files / batch size) model calls every run. For CI, use"
    ai_review::warn "  ai-security-compliance-review, which is diff-scoped."
  fi

  git rev-parse --git-dir >/dev/null 2>&1 || {
    ai_review::err "Not a git repository. Run this from the root of the repo to audit."
    exit 2
  }

  # ── Scope ──────────────────────────────────────────────────────────────
  local files_nl nfiles skip_log
  skip_log="$(mktemp)"
  export AI_AUDIT_SKIP_LOG="${skip_log}"
  export AI_AUDIT_COVERAGE_SNAPSHOT=""
  trap 'rm -f "${AI_AUDIT_SKIP_LOG:-}" "${AI_AUDIT_COVERAGE_SNAPSHOT:-}"; [[ -n "${AI_REVIEW_BATCH_DIR:-}" ]] && rm -rf "${AI_REVIEW_BATCH_DIR}"' EXIT
  files_nl="$(audit::scope_files)"
  nfiles="$(printf '%s\n' "${files_nl}" | grep -cv '^$' || true)"

  if ((nfiles == 0)); then
    ai_review::err "No files in scope ($(audit::scope_description))."
    ai_review::log "  Tracked, non-binary files under the given paths are audited."
    ai_review::log "  Check the paths, --include/--exclude, and --max-file-bytes."
    exit 2
  fi

  if ((LIST_FILES == 1)); then
    printf '%s\n' "${files_nl}"
    ai_review::info "${nfiles} file(s) in scope ($(audit::scope_description))."
    exit 0
  fi

  ai_review::resolve_tool

  # Required for a real run. Checked here — after --list-files has had its
  # chance to exit, before any model call — so inspecting scope needs no
  # output directory but producing findings cannot happen without somewhere to
  # put them.
  if [[ -z "${OUTPUT_PARENT}" && ${JSON_ONLY} -eq 0 &&
    ${AI_REVIEW_DRY_RUN} -eq 0 && ${AI_REVIEW_LIST_BATCHES} -eq 0 ]]; then
    ai_review::err "--output-parent-dir is required."
    ai_review::err "  An audit produces a report bundle; it needs an existing directory to"
    ai_review::err "  write it into. A new subdirectory <repo>-<YYYYMMDD>-<NN> is created"
    ai_review::err "  there per run."
    ai_review::err ""
    ai_review::err "    ai-security-compliance-audit --output-parent-dir ~/audits ${SCOPE_PATHS[*]:-}"
    ai_review::err ""
    ai_review::err "  Or --json-only to print findings to stdout and write nothing."
    exit 2
  fi
  if [[ -n "${OUTPUT_PARENT}" && ${AI_REVIEW_DRY_RUN} -eq 0 &&
    ${AI_REVIEW_LIST_BATCHES} -eq 0 ]]; then
    if [[ ! -d "${OUTPUT_PARENT}" ]]; then
      ai_review::err "--output-parent-dir '${OUTPUT_PARENT}' does not exist."
      ai_review::err "  It must be an existing directory; the audit will not create it."
      exit 2
    fi
    if [[ ! -r "${OUTPUT_PARENT}" || ! -w "${OUTPUT_PARENT}" || ! -x "${OUTPUT_PARENT}" ]]; then
      ai_review::err "--output-parent-dir '${OUTPUT_PARENT}' must be readable, writable and searchable."
      exit 2
    fi
  fi

  # ── Resume, if asked ───────────────────────────────────────────────────
  # Resume is per-file and fingerprint-based: unchanged files are skipped, and
  # new or changed files are always re-audited.
  ALL_DIRECTORIES="$(printf '%s\n' "${files_nl}" | python3 -c '
import posixpath, sys
dirs = set()
for raw in sys.stdin:
    path = raw.rstrip("\n")
    if not path:
        continue
    dirs.add(posixpath.dirname(path))
print("\n".join(sorted(dirs)))')"

  if ((RESUME == 1)); then
    if [[ -z "${OUTPUT_PARENT}" ]]; then
      ai_review::err "--resume needs --output-parent-dir: it has to know which bundle to continue."
      exit 2
    fi
    RESUME_DIR="$(audit::find_resume_dir "${OUTPUT_PARENT}")"
    if [[ -z "${RESUME_DIR}" ]]; then
      ai_review::warn "--resume: no existing bundle for this repo in ${OUTPUT_PARENT}; starting a new one."
      RESUME=0
    else
      ai_review::info "Resuming ${RESUME_DIR}"
      local before_count="${nfiles}"
      files_nl="$(audit::filter_resume_scope "${files_nl}" "${RESUME_DIR}/coverage.json" "${skip_log}")"
      nfiles="$(printf '%s\n' "${files_nl}" | grep -cv '^$' || true)"
      local skipped=$((before_count - nfiles))
      ai_review::info "  ${skipped} file(s) unchanged since the previous segment; ${nfiles} remaining."

      if ((nfiles == 0)); then
        # Nothing left to audit. Regenerate the index from what is already
        # there rather than reporting success having done nothing — a resumed
        # run that finds the work complete should still leave a current index.
        ai_review::ok "Nothing left to audit; the bundle is already complete."
        ai_review::log "  ${RESUME_DIR}/_INDEX.md"
        if ((JSON_ONLY == 1)) || [[ -n "${JSON_OUT}" || -n "${MD_OUT}" ]]; then
          local resumed_json
          if [[ ! -f "${RESUME_DIR}/findings.json" ]]; then
            ai_review::err "Resume bundle ${RESUME_DIR} has no findings.json to emit."
            exit 1
          fi
          resumed_json="$(cat "${RESUME_DIR}/findings.json")"
          if [[ -n "${JSON_OUT}" ]]; then
            printf '%s\n' "${resumed_json}" >"${JSON_OUT}"
            ai_review::info "Findings JSON written to ${JSON_OUT}"
          fi
          if [[ -n "${MD_OUT}" ]]; then
            printf '%s\n' "$(audit::render_narrative_from_json "${resumed_json}")" >"${MD_OUT}"
            ai_review::info "Report written to ${MD_OUT}"
          fi
          if ((JSON_ONLY == 1)); then
            printf '%s\n' "${resumed_json}"
          fi
        fi
        exit 0
      fi
    fi
  fi

  # ── Batch plan ─────────────────────────────────────────────────────────
  local -a _batch_records=()
  local _rec
  while IFS= read -r _rec; do
    [[ -z "${_rec}" ]] && continue
    _batch_records+=("${_rec}")
  done < <(printf '%s\n' "${files_nl}" | ai_review::group_files_into_batches |
    ai_review::pack_batches "${AI_REVIEW_JOBS}")
  local _nbatches=${#_batch_records[@]}

  if ((AI_REVIEW_LIST_BATCHES == 1)); then
    ai_review::info "Batch plan (batch-by=${AI_REVIEW_BATCH_BY:-dir}): ${nfiles} file(s) in ${_nbatches} batch(es)"
    for _rec in "${_batch_records[@]+"${_batch_records[@]}"}"; do
      printf '  %s\n' "${_rec%%$'\t'*}"
    done
    exit 0
  fi

  if ((AI_REVIEW_DRY_RUN == 1)); then
    ai_review::info "Plan (no AI call):"
    ai_review::log "  Scope:          $(audit::scope_description)"
    ai_review::log "  Files:          ${nfiles}"
    ai_review::log "  Batches:        ${_nbatches} (concurrency ${AI_REVIEW_JOBS})"
    ai_review::log "  Profile:        ${AI_REVIEW_PROFILE}"
    ai_review::log "  Tool:           ${AI_REVIEW_TOOL_RESOLVED}"
    # The audit sends the whole scope to the endpoint, not a diff, so WHERE it
    # goes is the most consequential line in this plan. Shown here so it can be
    # checked before any code leaves the machine — endpoint validation itself
    # runs after the dry-run gate, so --dry-run needs no credentials.
    ai_review::log "  Provider:       ${AI_REVIEW_PROVIDER:-api}$([[ -z "${AI_REVIEW_PROVIDER:-}" || "${AI_REVIEW_PROVIDER}" == "api" ]] && printf ' (PUBLIC endpoint — see docs/private-endpoints.md for in-boundary options)')"
    ai_review::log "  Adjudication:   $(ai_review::adjudication_mode)"
    ai_review::log "  Expected calls: ~${_nbatches} first-pass$([[ "$(ai_review::adjudication_mode)" == "independent" ]] && printf ' + 1 adjudication')"
    exit 0
  fi

  # Validate and configure the LLM endpoint now that a real invocation will
  # happen. Without this, AI_REVIEW_PROVIDER was silently ignored and an audit
  # configured for Bedrock or Azure went to the public API instead — the whole
  # scope, to the wrong place, with nothing reported.
  ai_review::configure_endpoint

  # ── Confirm before spending ────────────────────────────────────────────
  # A full-repo audit reads every file in scope and is the most expensive thing
  # in this repo by a wide margin — roughly one model call per batch, each
  # carrying a large rubric plus the files it reviews. Someone who typed
  # `audit` at the root of a monorepo expecting the speed of a lint run should
  # find out before the bill, not after.
  if ((ASSUME_YES == 0)); then
    if [[ ! -t 0 ]]; then
      ai_review::err "Refusing to start without confirmation: stdin is not a TTY."
      ai_review::err "  This would audit ${nfiles} file(s) across ${_nbatches} batch(es) —"
      ai_review::err "  roughly ${_nbatches} model call(s), each reading the files in its batch."
      ai_review::err "  Pass --yes (or AI_AUDIT_ASSUME_YES=1) to run non-interactively."
      exit 2
    fi
    ai_review::warn "This audit will send code to a model and consume tokens."
    ai_review::log "  Scope:          $(audit::scope_description)"
    ai_review::log "  Files:          ${nfiles}"
    ai_review::log "  Batches:        ${_nbatches} (concurrency ${AI_REVIEW_JOBS})"
    ai_review::log "  Expected calls: ~${_nbatches} first-pass$([[ "$(ai_review::adjudication_mode)" == "independent" ]] && printf ' + 1 adjudication')"
    ai_review::log "  Endpoint:       ${AI_REVIEW_PROVIDER:-api}$([[ -z "${AI_REVIEW_PROVIDER:-}" || "${AI_REVIEW_PROVIDER}" == "api" ]] && printf ' (PUBLIC — the whole scope leaves your machine)')"
    ai_review::log "  Report:         ${OUTPUT_PARENT:-(stdout only)}"
    ai_review::log ""
    ai_review::log "  --dry-run shows this plan without spending anything."
    printf '  Proceed? [y/N] ' >&2
    local reply=""
    read -r reply || reply=""
    case "${reply}" in
      y | Y | yes | YES) ;;
      *)
        ai_review::log "Aborted; nothing was sent."
        exit 0
        ;;
    esac
  fi

  if [[ -n "${OUTPUT_PARENT}" && ${JSON_ONLY} -eq 0 ]]; then
    AI_AUDIT_COVERAGE_SNAPSHOT="$(mktemp)"
    if ! audit::snapshot_file_hashes "${files_nl}" "${AI_AUDIT_COVERAGE_SNAPSHOT}"; then
      ai_review::err "Could not snapshot file hashes for resume coverage."
      exit 1
    fi
  fi

  # ── Audit ──────────────────────────────────────────────────────────────
  local audit_json result human_output="" bundle_output=""
  if ai_review::should_batch "${nfiles}" "${_nbatches}"; then
    ai_review::info "Auditing ${nfiles} file(s) under $(audit::scope_description) via ${AI_REVIEW_TOOL_RESOLVED} — ${_nbatches} batch(es)..."
    ai_review::log "────────────────────────────────────────────────────────────"

    AI_REVIEW_BATCH_DIR="$(mktemp -d)"
    AI_REVIEW_SELF="${BASH_SOURCE[0]}"
    export AI_REVIEW_SELF AI_REVIEW_PROFILE

    AI_REVIEW_FAN_COMPLETE=0
    AI_REVIEW_BATCH_SENTINELS=""
    AI_REVIEW_WORKER_FLAG="--__audit-one"
    export AI_REVIEW_WORKER_FLAG
    ai_review::fan_out "${_batch_records[@]}"
    ai_review::log "────────────────────────────────────────────────────────────"

    if ((AI_REVIEW_FAN_COMPLETE != 1)); then
      ai_review::err "Fan-out did not audit every batch; failing rather than reporting a partial audit."
      exit 1
    fi

    local -a _json_files=()
    local _line _jf
    while IFS= read -r _line; do
      [[ "${_line}" == AI_REVIEW_BATCH_RESULT* ]] || continue
      _jf="$(printf '%s' "${_line}" | cut -f4)"
      [[ -n "${_jf}" && "${_jf}" != "-" ]] && _json_files+=("${_jf}")
    done <<<"${AI_REVIEW_BATCH_SENTINELS}"

    audit_json="$(python3 "${AI_COMMON_HOME}/harness/fold_review_json.py" "${_json_files[@]}")"
    audit_json="$(audit::normalize_findings_for_audit "${audit_json}")"
    result="$(printf '%s' "${audit_json}" | python3 -c 'import json,sys; print(json.load(sys.stdin)["review_action"])')"
    human_output="$(audit::render_narrative_from_json "${audit_json}")"
    bundle_output="${human_output}"
  else
    export AI_REVIEW_SCOPE_PATHS="${files_nl}"
    AI_REVIEW_ADJUDICATION_MODE="$(ai_review::adjudication_mode)"
    export AI_REVIEW_ADJUDICATION_MODE
    SKILL_PROMPT="$(audit::build_prompt)"

    ai_review::info "Auditing ${nfiles} file(s) under $(audit::scope_description) via ${AI_REVIEW_TOOL_RESOLVED}..."
    ai_review::log "────────────────────────────────────────────────────────────"

    local invoke_rc=0
    human_output="$(ai_review::invoke_ai)" || invoke_rc=$?

    if ((JSON_ONLY == 0)); then
      printf '%s\n' "${human_output}"
      ai_review::log "────────────────────────────────────────────────────────────"
    fi

    if ((invoke_rc != 0)); then
      ai_review::err "AI CLI (${AI_REVIEW_TOOL_RESOLVED}) exited with code ${invoke_rc}."
      exit 1
    fi

    local marker
    marker="$(ai_review::parse_result "${human_output}")"
    if [[ "${marker}" == "UNPARSEABLE" ]]; then
      ai_review::err "No ${AI_REVIEW_MARKER_VOCAB} result marker in the AI response."
      exit 1
    fi
    if ! audit_json="$(audit::require_json "${human_output}" "${marker}")"; then
      ai_review::err "No parseable findings JSON block in the AI response, or it violated the output contract."
      exit 1
    fi
    result="$(printf '%s' "${audit_json}" | python3 -c 'import json,sys; print(json.load(sys.stdin)["review_action"])')"
    bundle_output="$(audit::narrative_from_ai_output "${human_output}")"
  fi

  # Independent adjudication runs in the parent process after fan-out fold.
  # Always provide the concrete audit scope list there.
  export AI_REVIEW_SCOPE_PATHS="${files_nl}"

  # ── Independent adjudication, once, on the whole audit ──────────────────
  if [[ "$(ai_review::adjudication_mode)" == "independent" && "${result}" != "APPROVE" ]]; then
    local adj_output adj_rc=0
    adj_output="$(ai_review::adjudicate "${audit_json}")" || adj_rc=$?
    if ((adj_rc == 0)); then
      local adj_marker adj_json
      adj_marker="$(ai_review::parse_result "${adj_output}")"
      if [[ "${adj_marker}" == "UNPARSEABLE" ]] ||
        ! adj_json="$(audit::require_json "${adj_output}" "${adj_marker}")"; then
        ai_review::warn "Adjudication produced no parseable marker/JSON; keeping the first-pass findings."
      elif ! ai_review::adjudication_is_safe "${audit_json}" "${adj_json}"; then
        ai_review::warn "Adjudication changed findings outside allowed bounds; keeping the first-pass findings."
      else
        audit_json="${adj_json}"
        result="$(printf '%s' "${audit_json}" | python3 -c 'import json,sys; print(json.load(sys.stdin)["review_action"])')"
        human_output="${adj_output}"
        bundle_output="$(audit::narrative_from_ai_output "${adj_output}")"
        ((JSON_ONLY == 0)) && printf '%s\n' "${adj_output}"
      fi
    else
      ai_review::warn "Adjudication failed (rc=${adj_rc}); keeping the first-pass findings."
    fi
  fi

  # --json-only skips bundle generation, so merge resumed findings here.
  if ((RESUME == 1)) && ((JSON_ONLY == 1)) && [[ -n "${RESUME_DIR}" && -f "${RESUME_DIR}/findings.json" ]]; then
    local resume_merged_file
    resume_merged_file="$(mktemp)"
    printf '%s\n' "${audit_json}" >"${resume_merged_file}"
    audit::merge_resume_findings "${RESUME_DIR}/findings.json" "${resume_merged_file}" "${files_nl}"
    audit_json="$(cat "${resume_merged_file}")"
    bundle_output="$(audit::render_narrative_from_json "${audit_json}")"
    result="$(printf '%s' "${audit_json}" | python3 -c 'import json,sys; print(json.load(sys.stdin)["review_action"])')"
    rm -f "${resume_merged_file}"
  fi

  # ── Report bundle ───────────────────────────────────────────────────────
  if [[ -n "${OUTPUT_PARENT}" && ${JSON_ONLY} -eq 0 ]]; then
    if [[ -z "${bundle_output//[[:space:]]/}" ]]; then
      bundle_output="$(audit::render_narrative_from_json "${audit_json}")"
    fi
    local run_dir meta_file findings_file segment_findings_file report_file coverage_file stage_dir backup_dir
    local run_parent run_name
    if ((RESUME == 1)) && [[ -n "${RESUME_DIR}" ]]; then
      run_dir="${RESUME_DIR}"
      [[ -d "${run_dir}" ]] || {
        ai_review::err "Resume bundle not found: ${run_dir}"
        exit 1
      }
    else
      run_dir="$(audit::allocate_run_dir "${OUTPUT_PARENT}")"
      if ! mkdir "${run_dir}" >/dev/null 2>&1; then
        ai_review::err "Could not allocate a new report bundle directory at ${run_dir}."
        ai_review::err "  Another run may have created it first; retry the audit."
        exit 1
      fi
    fi
    run_parent="$(dirname "${run_dir}")"
    run_name="$(basename "${run_dir}")"
    stage_dir="${run_parent}/.${run_name}.staging.$$"
    backup_dir="${run_parent}/.${run_name}.backup.$$"
    rm -rf "${stage_dir}" "${backup_dir}"
    mkdir -p "${stage_dir}"
    coverage_file="$(mktemp)"
    meta_file="$(mktemp)"
    findings_file="$(mktemp)"
    segment_findings_file="$(mktemp)"
    report_file="$(mktemp)"
    printf '%s\n' "${audit_json}" >"${findings_file}"
    cp "${findings_file}" "${segment_findings_file}"

    # On resume, carry the previous findings forward. Without this the
    # regenerated index would list only this segment's findings and the
    # already-written directory docs would be rewritten empty — a resumed run
    # would quietly DELETE the results it was meant to preserve.
    if ((RESUME == 1)) && [[ -f "${run_dir}/findings.json" ]]; then
      audit::merge_resume_findings "${run_dir}/findings.json" "${findings_file}" "${files_nl}"
      ai_review::info "  merged with the findings already in the bundle"
    fi
    if ((RESUME == 1)); then
      if ! python3 - "${segment_findings_file}" "${findings_file}" <<'PY'
import json, sys
before = json.load(open(sys.argv[1], encoding="utf-8"))
after = json.load(open(sys.argv[2], encoding="utf-8"))
raise SystemExit(0 if before == after else 1)
PY
      then
        local merged_summary
        merged_summary="$(python3 - "${findings_file}" <<'PY'
import json, sys
try:
    summary = str(json.load(open(sys.argv[1], encoding="utf-8")).get("summary") or "").strip()
except Exception:
    summary = ""
if summary:
    print(summary)
PY
)"
        if [[ -n "${bundle_output//[[:space:]]/}" && -n "${merged_summary//[[:space:]]/}" ]]; then
          bundle_output="${bundle_output}"$'\n\n---\n\n## Current merged findings status\n\n'"${merged_summary}"
        else
          bundle_output="$(audit::render_narrative_from_json "$(cat "${findings_file}")")"
        fi
      fi
    fi

    # Keep prior segment narratives for history, but mark this section as the
    # source of truth for files re-audited in this segment.
    if ((RESUME == 1)) && [[ -e "${run_dir}/report.md" && ! -f "${run_dir}/report.md" ]]; then
      ai_review::err "Could not write the report bundle to ${run_dir}."
      rm -rf "${stage_dir}" "${backup_dir}"
      rm -f "${coverage_file}" "${meta_file}" "${findings_file}" "${segment_findings_file}" "${report_file}"
      exit 1
    fi
    if ((RESUME == 1)) && [[ -f "${run_dir}/report.md" ]]; then
      {
        cat "${run_dir}/report.md"
        printf '\n\n---\n\n## Resumed segment (%s)\n\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        printf '> This segment supersedes findings for files re-audited in this run. Prior sections are historical snapshots and may include findings now cleared.\n\n'
        printf '%s\n' "${bundle_output}"
      } >"${report_file}"
    else
      printf '%s\n' "${bundle_output}" >"${report_file}"
    fi

    audit::write_coverage "${run_dir}/coverage.json" "${files_nl}" "${skip_log}" "${coverage_file}" "${AI_AUDIT_COVERAGE_SNAPSHOT:-}"

    local files_in_bundle
    files_in_bundle="$(python3 - "${coverage_file}" "${nfiles}" <<'PY'
import json, sys
default = int(sys.argv[2])
try:
    data = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception:
    print(default)
    raise SystemExit(0)
rows = data.get("audited_files", []) if isinstance(data, dict) else []
count = sum(1 for row in rows if isinstance(row, dict) and isinstance(row.get("path"), str) and row.get("path"))
print(count)
PY
)"

    # Every audited directory, so the index can say "audited and clean" rather
    # than leaving it ambiguous with "not audited".
    # Every directory in the ORIGINAL scope, so a resumed run's index still
    # lists the directories it skipped rather than implying they were never
    # audited.
    local dirs_json skipped_json
    dirs_json="$(
      AUDIT_DIRS_NL="${ALL_DIRECTORIES}" python3 - "${run_dir}/_meta.json" "${RESUME}" <<'PY'
import json, os, sys

dirs = {d.rstrip("\n") for d in os.environ.get("AUDIT_DIRS_NL", "").splitlines() if d.rstrip("\n")}
meta_path = sys.argv[1]
resume = sys.argv[2] == "1"
if resume:
    try:
        prev_meta = json.load(open(meta_path, encoding="utf-8"))
    except Exception:
        prev_meta = {}
    if isinstance(prev_meta, dict):
        for d in prev_meta.get("directories", []):
            if isinstance(d, str) and d:
                dirs.add(d)
print(json.dumps(sorted(dirs)))
PY
    )"
    skipped_json="$(python3 - "${coverage_file}" <<'PY'
import json, sys
try:
    data = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception:
    data = {}
rows = data.get("skipped_files", []) if isinstance(data, dict) else []
print(json.dumps(rows if isinstance(rows, list) else []))
PY
)"

    python3 - "${meta_file}" "${dirs_json}" "${skipped_json}" <<META
import json, sys
json.dump({
    "repo": "$(basename "$(git rev-parse --show-toplevel)")",
    "date": "$(date +%Y-%m-%d)",
    "run": "$(basename "${run_dir}" | sed 's/.*-//')",
    "scope": "$(audit::scope_description)",
    "profile": "${AI_REVIEW_PROFILE}",
    "tool": "${AI_REVIEW_TOOL_RESOLVED}",
    "provider": "${AI_REVIEW_PROVIDER:-api}",
    "adjudication": "$(ai_review::adjudication_mode)",
    "files": ${files_in_bundle},
    "directories": json.loads(sys.argv[2]),
    "skipped_files": json.loads(sys.argv[3]),
}, open(sys.argv[1], "w"))
META

    audit_json="$(cat "${findings_file}")"
    result="$(printf '%s' "${audit_json}" | python3 -c 'import json,sys; print(json.load(sys.stdin)["review_action"])')"

    if python3 "${AI_COMMON_HOME}/harness/write_audit_report.py" \
      "${stage_dir}" "${findings_file}" "${meta_file}" "${report_file}" >/dev/null; then
      if ! mv "${coverage_file}" "${stage_dir}/coverage.json"; then
        ai_review::err "Report bundle was generated, but coverage metadata could not be staged."
        rm -rf "${stage_dir}" "${backup_dir}"
        rm -f "${coverage_file}" "${meta_file}" "${findings_file}" "${segment_findings_file}" "${report_file}"
        exit 1
      fi
      if ! mv "${run_dir}" "${backup_dir}"; then
        ai_review::err "Could not prepare the existing report bundle for update (${run_dir})."
        rm -rf "${stage_dir}" "${backup_dir}"
        rm -f "${meta_file}" "${findings_file}" "${segment_findings_file}" "${report_file}"
        exit 1
      fi
      if ! mv "${stage_dir}" "${run_dir}"; then
        ai_review::err "Could not finalize the updated report bundle (${run_dir})."
        if ! mv "${backup_dir}" "${run_dir}" >/dev/null 2>&1; then
          ai_review::err "Rollback failed; preserving backup bundle at ${backup_dir}."
        else
          rm -rf "${backup_dir}"
        fi
        rm -rf "${stage_dir}"
        rm -f "${meta_file}" "${findings_file}" "${segment_findings_file}" "${report_file}"
        exit 1
      fi
      rm -rf "${backup_dir}"
      ai_review::ok "Report bundle written. Start here:"
      ai_review::log "  ${run_dir}/_INDEX.md"
    else
      ai_review::err "Could not write the report bundle to ${run_dir}."
      rm -rf "${stage_dir}" "${backup_dir}"
      rm -f "${coverage_file}" "${meta_file}" "${findings_file}" "${segment_findings_file}" "${report_file}"
      exit 1
    fi
    rm -f "${meta_file}" "${findings_file}" "${segment_findings_file}" "${report_file}"
  fi

  # ── Artifacts, only where asked ─────────────────────────────────────────
  if [[ -n "${JSON_OUT}" ]]; then
    printf '%s\n' "${audit_json}" >"${JSON_OUT}"
    ai_review::info "Findings JSON written to ${JSON_OUT}"
  fi
  if [[ -n "${MD_OUT}" ]]; then
    local md_output
    md_output="${bundle_output}"
    if [[ -z "${md_output//[[:space:]]/}" ]]; then
      md_output="$(audit::narrative_from_ai_output "${human_output}")"
    fi
    if [[ -z "${md_output//[[:space:]]/}" ]]; then
      md_output="$(audit::render_narrative_from_json "${audit_json}")"
    fi
    printf '%s\n' "${md_output}" >"${MD_OUT}"
    ai_review::info "Report written to ${MD_OUT}"
  fi
  if ((JSON_ONLY == 1)); then
    printf '%s\n' "${audit_json}"
  fi

  local nfindings
  nfindings="$(printf '%s' "${audit_json}" |
    python3 -c 'import json,sys; print(len(json.load(sys.stdin).get("comments") or []))')"
  ai_review::ok "Audit complete: ${nfindings} finding(s) across ${nfiles} file(s) (${result})."
  exit 0
}

# ── Dispatch ────────────────────────────────────────────────────────────────
audit::parse_flags "$@"

if ((WORKER_MODE == 1)); then
  [[ -n "${WORKER_RECORD}" && -n "${AI_REVIEW_BATCH_DIR:-}" ]] || {
    ai_review::err "Internal error: --__audit-one requires a batch record and AI_REVIEW_BATCH_DIR."
    exit 2
  }
  ai_review::parse_args
  audit::worker_main "${WORKER_RECORD}"
  exit 0
fi

ai_review::parse_args "${REMAINING_FOR_LIB[@]+"${REMAINING_FOR_LIB[@]}"}"

# --doctor runs before anything that needs a git repo, a scope, or credentials.
((DOCTOR == 1)) && audit::doctor

audit::run
